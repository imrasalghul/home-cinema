# Replace every value before running the application. These are examples only.
SITE_NAME=Media Home
PORT=3001
APP_PORT=3210
APP_PUBLIC_URL=https://media.example.com
SESSION_SECRET=replace-with-a-long-random-secret-value

# Plex Media Server
PLEX_SERVER_URL=http://plex.example:32400
PLEX_MACHINE_ID=replace-with-your-plex-machine-id
PLEX_CLIENT_IDENTIFIER=00000000-0000-4000-8000-000000000001
PLEX_PATH_MAPPINGS={}

# TVHeadend
TVHEADEND_URL=http://tvheadend.example:9981
TVHEADEND_USERNAME=example-user
TVHEADEND_PASSWORD=example-only-change-me

# Local media path visible inside the app container
MEDIA_ROOT=/media/library

# Optional request integration (Seerr)
SEERR_URL=https://seerr.example.com
SEERR_API_KEY=replace-with-seerr-api-key

# Invidious provides the YouTube API and media information
INVIDIOUS_URL=https://invidious.example.com

# Navidrome music server
NAVIDROME_URL=http://navidrome.example:4533
NAVIDROME_USERNAME=example-user
NAVIDROME_PASSWORD=example-only-change-me

# Optional Genius API access token for lyrics
GENIUS_ACCESS_TOKEN=replace-with-genius-access-token
